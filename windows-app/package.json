{
  "name": "vectra-sensor-monitor",
  "version": "0.4.0",
  "author": "VECTRA",
  "private": true,
  "description": "Windows desktop application for RS485 Modbus motor vibration monitoring",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node tests/sensor-codec.cjs && node tests/desktop-smoke.cjs",
    "test:sensor": "node tests/sensor-codec.cjs",
    "test:desktop": "node tests/desktop-smoke.cjs",
    "dist:win": "electron-builder --win nsis portable",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "modbus-serial": "8.0.25",
    "serialport": "13.0.0"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "playwright": "1.64.1"
  },
  "build": {
    "appId": "th.vectra.sensor.monitor",
    "productName": "VECTRA Sensor Monitor",
    "asar": true,
    "asarUnpack": [
      "node_modules/@serialport/**"
    ],
    "files": [
      "src/**",
      "electron/**",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
    }
  }
}
